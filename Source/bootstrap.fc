// This is a forth-comment file, this is not executable as \
// the system this is built for does not support comments.
// To run this, copy it to a different file and then \
// remove everything from each `//` to the next newline.
// In addition to comments, .fc files also support basic macros,
// defined with $define [argnum] [name] [body] $enddef
// Note that all macros must be defined at the start of the file.

// addresses
$define aHERE  aINTERPS 4 + $enddef
$define aSTATE  aINTERPS 8 + $enddef
$define aSCAN_START  aINTERPS 9 + $enddef
$define aCOMP_START  aINTERPS 10 + $enddef

// variables
$define HERE  $aHERE @d $enddef
$define COMP_START  $aCOMP_START @d $enddef
$define LATEST  aINTERPS @d $enddef

// actions
$define ALLOT  $0 $HERE + $aHERE !d $enddef
$define ,b  $0 $HERE !b $ALLOT<1> $enddef
$define ,w  $0 $HERE !w $ALLOT<2> $enddef
$define ,d  $0 $HERE !d $ALLOT<4> $enddef
$define ,q  $0 $HERE !q $ALLOT<8> $enddef
$define COMPILE  CLEAR WORD $0 FIND ECR32 $enddef
$define DEFINITION_START $HERE $aCOMP_START !d $enddef
$define DEFINITION_END $COMP_START $LATEST 4 + !d $enddef

$define CREATE

$HERE // push HERE so we can later patch latest_def

$,d<$LATEST> // set link to latest_def
$,d<26> // set code pointer to GREET for placeholder behaviour
$,b<0> // give the word default behaviour
$0 $,b<0> // name the word

aINTERPS !d // patch latest_def

$enddef

// bootstrap code

// [
$DEFINITION_START

// set mode to interpreting
0 LITERAL
$COMPILE<aINTERPS>
8 LITERAL
$COMPILE<+>
$COMPILE<!b>
$,b<-61>

$CREATE<$,b<91>>

1 $LATEST 8 + !b // make [ an immediate word

$DEFINITION_END


// ]
$DEFINITION_START

// set mode to compiling
1 LITERAL
$COMPILE<aINTERPS>
8 LITERAL
$COMPILE<+>
$COMPILE<!b>
$,b<-61>

$CREATE<$,b<93>>

$DEFINITION_END


// aHERE
$DEFINITION_START

] $aHERE [ $,b<-61>

$CREATE<$,b<97> $,b<72> $,b<69> $,b<82> $,b<69>>

$DEFINITION_END


// HERE
$DEFINITION_START

] aHERE @d [ $,b<-61>

$CREATE<$,b<72> $,b<69> $,b<82> $,b<69>>

$DEFINITION_END


// ALLOT
$DEFINITION_START

] HERE + aHERE !d [ $,b<-61>

$CREATE<$,b<65> $,b<76> $,b<76> $,b<79> $,b<84>>

$DEFINITION_END


// ,b
$DEFINITION_START

] HERE !b 1 ALLOT [ $,b<-61>

$CREATE<$,b<44> $,b<98>>

$DEFINITION_END


// ,w
$DEFINITION_START

] HERE !w 2 ALLOT [ -61 ,b

$CREATE<44 ,b 119 ,b>

$DEFINITION_END


// ,d
$DEFINITION_START

] HERE !d 4 ALLOT [ -61 ,b

$CREATE<44 ,b 100 ,b>

$DEFINITION_END


// ,q
$DEFINITION_START

] HERE !q 8 ALLOT [ -61 ,b

$CREATE<44 ,b 113 ,b>

$DEFINITION_END


// MKENTR
$DEFINITION_START

]

HERE // push here so we can patch latest_def later

aINTERPS @d ,d // link
26 ,d // code, placeholder pointer to GREET
16 ,b // flags, 16 is ALIAS because currently the word has no unique body

SWAP // put string pointer on top of stack

[ HERE ] // push address we'll jump to

DUP @b ,b
1 +

DUP @b
[ 5 ] 0BRANCH // end loop
[ HERE 5 + SWAP - ] BRANCH // jump to start of loop

0 ,b // delimit string

POP // remove string pointer
aINTERPS !d // patch latest_def

[

-61 ,b // ret

$CREATE<77 ,b 75 ,b 69 ,b 78 ,b 84 ,b 82 ,b>

$DEFINITION_END


// CREATE
$DEFINITION_START

] WORD MKENTR [ -61 ,b

$CREATE<67 ,b 82 ,b 69 ,b 65 ,b 84 ,b 69 ,b>

$DEFINITION_END


HERE aINTERPS 10 + !d
    ]
        aINTERPS 10 +
    [
-61 ,b CREATE aCOMP_START 0 aINTERPS @d 8 + !b
aINTERPS 10 + @d aINTERPS @d 4 + !d


HERE aCOMP_START !d
    ]
        aCOMP_START @d
    [
-61 ,b CREATE COMP_START 0 aINTERPS @d 8 + !b
aCOMP_START @d aINTERPS @d 4 + !d


HERE aCOMP_START !d
    ]
        aINTERPS @d
    [
-61 ,b CREATE LATEST 0 aINTERPS @d 8 + !b
COMP_START aINTERPS @d 4 + !d


HERE aCOMP_START !d
    ]
        LATEST 8 + @b 1 | LATEST 8 + !b
    [
-61 ,b CREATE IMMEDIATE 0 LATEST 8 + !b
COMP_START LATEST 4 + !d


// COMPILE is an immediate word that forces a word to be compiled even if it is immediate
HERE aCOMP_START !d
    ]
        WORD FIND ECR32
    [
-61 ,b CREATE COMPILE 0 LATEST 8 + !b
COMP_START LATEST 4 + !d IMMEDIATE


// WNB pushes the address of the word name buffer,
// which is used by colon definitions to store the name \
// of the word currently being defined
HERE aCOMP_START !d
    ]
        [ HERE 18 + ] LITERAL [ -61 ,b ] [ 255 ALLOT ]
    [
CREATE WNB 0 LATEST 8 + !b
COMP_START LATEST 4 + !d


// WNB_WRITE takes a string pointer as an argument,
// and copies the string to the word name buffer
HERE aCOMP_START !d
    ]
        // this loop is effectively a BEGIN ... UNTIL loop so even if the string we pass it
        // has a length of 0 then it will still copy one byte, this is fine though since
        // we always start at idx 0 and the WNB is long enough, so no memory gets corrupted
        0
        [ HERE ] // start of loop

        OVER OVER + // push strptr + index
        OVER WNB + // push wnb + index
        SWAP // strptr + index now on top

        @b SWAP !b // get char and store it at WNB

        1 + // increment index

        OVER OVER + @b // we terminate the loop when char is NUL
        [ 5 ] 0BRANCH // exit loop
        [ HERE 5 + SWAP - ] BRANCH // repeat

        SWAP POP // remove strptr
        WNB + 0 SWAP !b // NUL-terminate string 
    [
-61 ,b CREATE WNB_WRITE 0 LATEST 8 + !b
COMP_START LATEST 4 + !d


// colon starts a definition by setting COMP_START and entering compile mode
HERE aCOMP_START !d
    ]
        WORD WNB_WRITE HERE aCOMP_START !d ]
    [
-61 ,b CREATE : 0 LATEST 8 + !b
COMP_START LATEST 4 + !d

// semicolon finishes a definition by compiling a `ret` and patching the code pointer as well as flag byte of the new word
// semicolon needs to be immediate since otherwise it wouldn't exit compilation
: ;
    COMPILE [ -61 ,b
    WNB MKENTR COMP_START LATEST 4 + !d
    0 LATEST 8 + !b
[
-61 ,b WNB MKENTR 0 LATEST 8 + !b
COMP_START LATEST 4 + !d IMMEDIATE

// With these words we round out the set of words for manipulating interpreter state.
: aSTATE aINTERPS 8 + ;
: aSCAN_START aINTERPS 9 + ;
: aTIB_IDX aINTERPS 14 + ;
: aTIB_LEN aINTERPS 15 + ;
: aTIB aINTERPS 16 + ;
: STATE aSTATE @b ;
: SCAN_START aSCAN_START @b ;
: TIB_IDX aTIB_IDX @b ;
: TIB_LEN aTIB_LEN @b ;

// Useful for debugging without accidentally corrupting the stack.
: PEEK DUP . ;

// Patch LATEST's code pointer, taking an address from the stack.
: >CODE LATEST 4 + !d ;

// Unset LATEST's ALIAS flag if it is set.
: UNIQUE
    LATEST 8 + @b 16 &
    [ 0 0BRANCH HERE ]
        LATEST 8 + @b 16 ^ LATEST 8 + !b
    [ DUP HERE - SWAP -4 + !d ]
;

// Text wrapper for >CODE, gets the code pointer from the next token.
: ALIAS WORD FIND 4 + @d >CODE ;

// Used in CONSTANT and VARIABLE to remove runtime indirection.
: __CONSTANT
    STATE
    [ 0 0BRANCH HERE ]
        COMPILE LITERAL
    [ DUP HERE - SWAP -4 + !d ]
;

// VARIABLE is relatively complicated, but essentially we \
// create a new word, and make that word push the address of a \
// block of memory it owns, who's size is the argument to VARIABLE.
// So it could be used like CELL VARIABLE X to make a variable called X with \
// a size of 8 bytes.
// Note that VARIABLE shouldn't be called inside colon definitions, this is because \
// it is a defining word and would corrupt COMP_START as well as LATEST for the word that called it.
: VARIABLE
    // set compilation start pointer
    HERE aCOMP_START !d

    // 23 because we need to skip over the literal,
    // and the call to __CONSTANT, as well as \
    // the final ret (17 + 5 + 1).
    HERE 23 + COMPILE LITERAL 
    [ CLEAR WORD __CONSTANT FIND ] LITERAL ECR32
    -61 ,b ALLOT

    // make the new variable immediate so __CONSTANT works properly.
    CREATE UNIQUE IMMEDIATE

    // patch the new word's code pointer
    COMP_START >CODE
;

// CSTCK is the control flow stack, and CSPTR points to the next free slot in it.
2 VARIABLE CSPTR
64 8 * VARIABLE CSTCK
// initialize the stack pointer to index 0 in the control flow stack
CSTCK CSPTR !w

// >C puts one value into the control flow stack
: >C CSPTR @w !q CSPTR @w 8 + CSPTR !w ;

// C> pops one value from the control flow stack
: C> CSPTR @w -8 + CSPTR !w CSPTR @w @q ;

// read the value at the top of the control flow stack without popping it
: C@ CSPTR @w -8 + @q ;

// stack helpers
: TUCK SWAP OVER ;
: NIP SWAP POP ;
: 2POP POP POP ;
: 2DUP OVER OVER ;
: 2SWAP ROT >C ROT C> ;

// conditionals
: IF 0 COMPILE 0BRANCH HERE >C ; IMMEDIATE
: THEN C@ HERE - C> -4 + !d  ; IMMEDIATE
: ELSE 0 COMPILE BRANCH HERE COMPILE THEN >C ; IMMEDIATE

// loops
: BEGIN HERE >C ; IMMEDIATE
: UNTIL C> HERE 14 + SWAP - COMPILE 0BRANCH ; IMMEDIATE
: AGAIN C> HERE 5 + SWAP - COMPILE BRANCH ; IMMEDIATE
: REPEAT C> C> SWAP >C >C COMPILE AGAIN COMPILE ELSE C> POP ; IMMEDIATE
// WHILE is semantically just IF so we don't compile a separate code body for it,
// but it's useful to have a separate dictionary entry so that code is more readable.
// After all, BEGIN IF REPEAT is a bit weird and makes it unclear whether there should be a THEN.
CREATE WHILE ALIAS IF IMMEDIATE

// CONSTANT is a defining word that pops a value from the stack \
// and defines a word who's behaviour is to push that value.
// It's complicated slightly by __CONSTANT, which exists for \
// an optimization; we make the new word immediate and then \
// based on whether it's used inside a definition or not \
// we can directly compile the literal instead of at runtime \
// always calling the word.
// Essentially, this means that `: A 2 ;` and `2 CONSTANT X ` : A X ; \
// should result in the same compiled code, but just using `X` in the REPL \
// will not accidentally compile a literal, but rather just push the value.
: CONSTANT 
    :
    COMPILE LITERAL
    [ CLEAR WORD __CONSTANT FIND ] LITERAL ECR32
    COMPILE ;
    UNIQUE IMMEDIATE
;

// Integer constants for testing numeric parsers or making sure over/underflow works for different words.
-9223372036854775808 CONSTANT INT64_MIN
9223372036854775807 CONSTANT INT64_MAX

// Booleans.
-1 CONSTANT TRUE
0 CONSTANT FALSE

// Since this Forth is untyped, the only thing we \
// really care about is the *size* of a variable,
// these words define the common data widths.
1 CONSTANT BYTE_T
2 CONSTANT WORD_T
4 CONSTANT DWORD_T
8 CONSTANT QWORD_T

// "emit jump rel32", this is used for tail calls,
// note that since the compiler doesn't know when definitions end \
// you have to write EJR32 manually if you want something to be compiled as a tail call.
: EJR32 -23 ,b 4 + @d HERE 4 + SWAP - ,d ;

// Since semicolon patches a word's code address this means that writing \
// `: A A ;` will actually not recurse, but rather call whatever A's previous definition was
// so we provide SELF for recursion instead.
: SELF aCOMP_START -4 + ECR32 ; IMMEDIATE
// tail call version of SELF
: TSELF aCOMP_START -4 + EJR32 ; IMMEDIATE

// Take string pointer to filepath, attempt to open a file with it and redirect stdin to the file,
// closing whatever fd stdin was previously.
: EXECF
    // duplicate return value so we can call both dup2 and close with the fd
    >C 0 DUP DUP DUP DUP BASE C> + 2 SYSCALL // sys_open
    DUP +? IF
        DUP >C >C
        0 DUP DUP DUP 0 C> 33 SYSCALL // sys_dup2
        DUP +? IF
            POP // discard value if no error
        THEN
        0 DUP DUP DUP DUP C> 3 SYSCALL POP // sys_close
    THEN // open failure
;
// Version of EXECF that gets its input in a more REPL-friendly way.
: LOAD WORD EXECF ;

// Takes a filepath as an argument and writes everything from the image start to HERE \
// to it, creating the file if it does not exist.
: IDUMP
    // we open the file with O_APPEND, O_TRUNC, O_CREAT, and O_WRONLY
    >C 0 DUP DUP 493 1024 512 64 1 | | | BASE C> + 2 SYSCALL // sys_open
    DUP +? IF
        HERE

        // top of stack in this loop is the remaining amount of bytes to write,
        // and just below it is the file descriptor to write to
        BEGIN

        DUP WHILE // if no more bytes to write, finish
            2DUP SWAP >C >C

            0 DUP DUP // unused syscall args

            C> // bytes to write
            DUP HERE - BASE + // start point; `BASE + (HERE - bytes to write)`
            C> // fd
            1 SYSCALL // sys_write

            DUP -? IF
                // early return with the value from sys_write
                >C 2POP C> EXIT
            ELSE
                SWAP -
            THEN
        REPEAT
        POP
        >C 0 DUP DUP DUP DUP C> 3 SYSCALL // sys_close
    THEN // open failure
;

// REPL wrapper for IDUMP, gets the filepath from the token stream,
// and also sets TIB_LEN and TIB_IDX to 0 while saving their values \
// to make sure that unparsed words do not get invoked when the \
// image snapshot is loaded.
BYTE_T VARIABLE SNAPSHOT_TIDX
BYTE_T VARIABLE SNAPSHOT_TLEN
: SNAPSHOT
    WORD

    // store TIB_IDX and TIB_LEN for later restoration
    TIB_IDX SNAPSHOT_TIDX !b
    TIB_LEN SNAPSHOT_TLEN !b

    // zero TIB_IDX and TIB_LEN so that the file written by IDUMP will not \
    // remember the REPL state of the image that wrote it, as that would \
    // cause the outer interpreter to immediately start interpreting whatever \
    // unparsed tokens were left in the TIB
    0 aTIB_IDX !b
    0 aTIB_LEN !b

    // call IDUMP and print its return value so the user knows if it succeeded or not
    IDUMP .

    // restore interpreter state
    SNAPSHOT_TIDX @b aTIB_IDX !b
    SNAPSHOT_TLEN @b aTIB_LEN !b
;

// Set a word to run every time the image is loaded, note that this does not immediately \
// run the word, but rather compiles it into the image start, meaning unless you SNAPSHOT \
// the image, and rerun the new binary, you will not see the new behaviour. Unless changed by SET_INIT, \
// the init command is INTERPRET.
: SET_INIT HERE 20 aHERE !d COMPILE COMPILE aHERE !d ;

// There are still many features this file does not implement, but we end it here \
// because all we really need is a way to save the image, as well as the core language.
// The rest of the stdlib as well as language features will be in other files.
