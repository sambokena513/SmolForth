// This is a forth-comment file, this is not executable as \
// the system this is built for does not support comments.
// To run this, copy it to a different file and then \
// remove everything from each `//` to the next newline.
// In addition to comments, .fc files also support basic macros,
// defined with $define [argnum] [name] [body] $enddef
// Note that all macros must be defined at the start of the file.

// addresses
$define aHERE  aINTERPS 4 + $enddef
$define aSTATE  aINTERPS 8 + $enddef
$define aSCAN_START  aINTERPS 9 + $enddef
$define aCOMP_START  aINTERPS 10 + $enddef

// variables
$define HERE  $aHERE @d $enddef
$define COMP_START  $aCOMP_START @d $enddef
$define LATEST  aINTERPS @d $enddef

// actions
$define ALLOT  $0 $HERE + $aHERE !d $enddef
$define ,b  $0 $HERE !b $ALLOT<1> $enddef
$define ,w  $0 $HERE !w $ALLOT<2> $enddef
$define ,d  $0 $HERE !d $ALLOT<4> $enddef
$define ,q  $0 $HERE !q $ALLOT<8> $enddef
$define COMPILE  WORD $0 FIND ECR32 $enddef

$define CREATE

$HERE // push HERE so we can later patch latest_def

$,d<$LATEST> // set link to latest_def
$,d<9> // set code pointer to GREET for placeholder behaviour
$,b<0> // give the word default behaviour
$0 $,b<0> // name the word

aINTERPS !d // patch latest_def

$enddef



// bootstrap code

// [
$CREATE<$,b<91>>

1 WORD [ FIND 8 + !b // make [ an immediate word

$HERE $aCOMP_START !d

// set mode to interpreting
$COMPILE<LIT>
$,q<0>
$COMPILE<aINTERPS>
$COMPILE<LIT>
$,q<8>
$COMPILE<+>
$COMPILE<!b>
$,b<-61>

$COMP_START WORD [ FIND 4 + !d


// ]
$CREATE<$,b<93>>

$HERE $aCOMP_START !d

// set mode to compiling
$COMPILE<LIT>
$,q<1>
$COMPILE<aINTERPS>
$COMPILE<LIT>
$,q<8>
$COMPILE<+>
$COMPILE<!b>
$,b<-61>

$COMP_START WORD ] FIND 4 + !d


// aHERE
$CREATE<$,b<97> $,b<72> $,b<69> $,b<82> $,b<69>>

$HERE $aCOMP_START !d

] $aHERE [ $,b<-61>

$COMP_START WORD aHERE FIND 4 + !d


// HERE
$CREATE<$,b<72> $,b<69> $,b<82> $,b<69>>

$HERE $aCOMP_START !d

] aHERE @d [ $,b<-61>

$COMP_START WORD HERE FIND 4 + !d


// ALLOT
$CREATE<$,b<65> $,b<76> $,b<76> $,b<79> $,b<84>>

$HERE $aCOMP_START !d

] HERE + aHERE !d [ $,b<-61>

$COMP_START WORD ALLOT FIND 4 + !d


// ,b
$CREATE<$,b<44> $,b<98>>

$HERE $aCOMP_START !d

] HERE !b 1 ALLOT [ $,b<-61>

$COMP_START WORD ,b FIND 4 + !d


// ,w
$CREATE<44 ,b 119 ,b>

$HERE $aCOMP_START !d

] HERE !w 2 ALLOT [ -61 ,b

$COMP_START WORD ,w FIND 4 + !d


// ,d
$CREATE<44 ,b 100 ,b>

$HERE $aCOMP_START !d

] HERE !d 4 ALLOT [ -61 ,b

$COMP_START WORD ,d FIND 4 + !d


// ,q
$CREATE<44 ,b 113 ,b>

$HERE $aCOMP_START !d

] HERE !q 8 ALLOT [ -61 ,b

$COMP_START WORD ,q FIND 4 + !d


// CREATE
$CREATE<67 ,b 82 ,b 69 ,b 65 ,b 84 ,b 69 ,b>

$HERE $aCOMP_START !d

]

HERE // push here so we can patch latest_def later

aINTERPS @d ,d // link
9 ,d // code
0 ,b // flags

// name
WORD

[ HERE ] // push address we'll jump to

DUP @b ,b
1 +

DUP @b
0BR [ 22 ,d ] // end loop
0 0BR [ HERE 4 + SWAP - ,d ] // jump to start of loop

0 ,b // delimit string

POP // remove WORD result
aINTERPS !d // patch latest_def

[

-61 ,b // ret

$COMP_START WORD CREATE FIND 4 + !d


CREATE aCOMP_START 
    HERE aINTERPS 10 + !d 
        ]
            aINTERPS 10 +
        [ 
    -61 ,b aINTERPS 10 + @d 
    aINTERPS @d 4 + !d

CREATE COMP_START 
    HERE aINTERPS 10 + !d 
        ]
            aCOMP_START @d
        [ 
    -61 ,b aINTERPS 10 + @d 
    aINTERPS @d 4 + !d

CREATE :
    HERE aCOMP_START !d
        ]
            // colon makes a dictionary entry, sets COMP_START, and enters compile mode
            CREATE HERE aCOMP_START !d ]
        [
    -61 ,b COMP_START
    aINTERPS @d 4 + !d

: LATEST aINTERPS @d [ -61 ,b COMP_START WORD LATEST FIND 4 + !d

: IMMEDIATE LATEST 8 + @b 1 | LATEST 8 + !b [ -61 ,b COMP_START LATEST 4 + !d

// COMPILE is an immediate word
: COMPILE WORD FIND ECR32 [ -61 ,b COMP_START LATEST 4 + !d IMMEDIATE

// semicolon needs to be immediate since otherwise it wouldn't exit compilation
: ; COMPILE [ -61 ,b COMP_START LATEST 4 + !d [ -61 ,b COMP_START LATEST 4 + !d IMMEDIATE

// Useful for debugging without accidentally corrupting the stack.
: PEEK DUP . ;

// 0BRANCH is to 0BR what LITERAL is to LIT.
: 0BRANCH [ WORD 0BR FIND ] LITERAL ECR32 ,d ; IMMEDIATE

// Since this Forth is untyped, the only thing we \
// really care about is the *size* of a variable,
// these words define the common data widths.
: BYTE_T 1 ;
: WORD_T 2 ;
: DWORD_T 4 ;
: QWORD_T 8 ;

// VARIABLE is relatively complicated, but essentially we \
// create a new word, and make that word push the address of a \
// block of memory it owns, who's size is the argument to VARIABLE.
// So it could be used like CELL VARIABLE X to make a variable called X with \
// a size of 8 bytes.
// Note that VARIABLE shouldn't be called inside colon definitions, this is because \
// it is a defining word and would corrupt COMP_START as well as LATEST for the word that called it.
: VARIABLE CREATE HERE LATEST 4 + !d HERE 14 + COMPILE LITERAL -61 ,b ALLOT ; 

// CSTCK is the control flow stack, and CSPTR points to the next free slot in it.
WORD_T VARIABLE CSPTR
64 DWORD_T * VARIABLE CSTCK
// initialize the stack pointer to index 0 in the control flow stack
CSTCK CSPTR !w

// >C puts one value into the control flow stack
: >C CSPTR @w !d CSPTR @w DWORD_T + CSPTR !w ;

// C> pops one value from the control flow stack
: C> CSPTR @w DWORD_T SWAP - CSPTR !w CSPTR @w @d ;

