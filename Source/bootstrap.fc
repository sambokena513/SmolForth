// This is a forth-comment file, this is not executable as \
// the system this is built for does not support comments.
// To run this, copy it to a different file and then \
// remove everything from each `//` to the next newline.
// In addition to comments, .fc files also support basic macros,
// defined with $define [argnum] [name] [body] $enddef
// Note that all macros must be defined at the start of the file.

// addresses
$define aHERE  aINTERPS 4 + $enddef
$define aSTATE  aINTERPS 8 + $enddef
$define aSCAN_START  aINTERPS 9 + $enddef
$define aCOMP_START  aINTERPS 10 + $enddef

// variables
$define HERE  $aHERE @d $enddef
$define COMP_START  $aCOMP_START @d $enddef
$define LATEST  aINTERPS @d $enddef

// actions
$define ALLOT  $0 $HERE + $aHERE !d $enddef
$define ,b  $0 $HERE !b $ALLOT<1> $enddef
$define ,w  $0 $HERE !w $ALLOT<2> $enddef
$define ,d  $0 $HERE !d $ALLOT<4> $enddef
$define ,q  $0 $HERE !q $ALLOT<8> $enddef
$define COMPILE  WORD $0 FIND ECR32 $enddef

$define CREATE

$HERE // push HERE so we can later patch latest_def

$,d<$LATEST> // set link to latest_def
$,d<9> // set code pointer to GREET for placeholder behaviour
$,b<0> // give the word default behaviour
$0 $,b<0> // name the word

aINTERPS !d // patch latest_def

$enddef



// bootstrap code

// [
$CREATE<$,b<91>>

1 WORD [ FIND 8 + !b // make [ an immediate word

$HERE $aCOMP_START !d

// set mode to interpreting
$COMPILE<LIT>
$,q<0>
$COMPILE<aINTERPS>
$COMPILE<LIT>
$,q<8>
$COMPILE<+>
$COMPILE<!b>
$,b<-61>

$COMP_START WORD [ FIND 4 + !d


// ]
$CREATE<$,b<93>>

$HERE $aCOMP_START !d

// set mode to compiling
$COMPILE<LIT>
$,q<1>
$COMPILE<aINTERPS>
$COMPILE<LIT>
$,q<8>
$COMPILE<+>
$COMPILE<!b>
$,b<-61>

$COMP_START WORD ] FIND 4 + !d


// aHERE
$CREATE<$,b<97> $,b<72> $,b<69> $,b<82> $,b<69>>

$HERE $aCOMP_START !d

] $aHERE [ $,b<-61>

$COMP_START WORD aHERE FIND 4 + !d


// HERE
$CREATE<$,b<72> $,b<69> $,b<82> $,b<69>>

$HERE $aCOMP_START !d

] aHERE @d [ $,b<-61>

$COMP_START WORD HERE FIND 4 + !d


// ALLOT
$CREATE<$,b<65> $,b<76> $,b<76> $,b<79> $,b<84>>

$HERE $aCOMP_START !d

] HERE + aHERE !d [ $,b<-61>

$COMP_START WORD ALLOT FIND 4 + !d


// ,b
$CREATE<$,b<44> $,b<98>>

$HERE $aCOMP_START !d

] HERE !b 1 ALLOT [ $,b<-61>

$COMP_START WORD ,b FIND 4 + !d


// ,w
$CREATE<44 ,b 119 ,b>

$HERE $aCOMP_START !d

] HERE !w 2 ALLOT [ -61 ,b

$COMP_START WORD ,w FIND 4 + !d


// ,d
$CREATE<44 ,b 100 ,b>

$HERE $aCOMP_START !d

] HERE !d 4 ALLOT [ -61 ,b

$COMP_START WORD ,d FIND 4 + !d


// ,q
$CREATE<44 ,b 113 ,b>

$HERE $aCOMP_START !d

] HERE !q 8 ALLOT [ -61 ,b

$COMP_START WORD ,q FIND 4 + !d


// CREATE
$CREATE<67 ,b 82 ,b 69 ,b 65 ,b 84 ,b 69 ,b>

$HERE $aCOMP_START !d

]

HERE // push here so we can patch latest_def later

aINTERPS @d ,d // link
9 ,d // code
0 ,b // flags

// name
WORD

[ HERE ] // push address we'll jump to

DUP @b ,b
1 +

DUP @b
0BR [ 22 ,d ] // end loop
0 0BR [ HERE 4 + SWAP - ,d ] // jump to start of loop

0 ,b // delimit string

POP // remove WORD result
aINTERPS !d // patch latest_def

[

-61 ,b // ret

$COMP_START WORD CREATE FIND 4 + !d


CREATE aCOMP_START 
    HERE aINTERPS 10 + !d 
        ]
            aINTERPS 10 +
        [ 
    -61 ,b aINTERPS 10 + @d 
    aINTERPS @d 4 + !d

CREATE COMP_START 
    HERE aINTERPS 10 + !d 
        ]
            aCOMP_START @d
        [ 
    -61 ,b aINTERPS 10 + @d 
    aINTERPS @d 4 + !d

CREATE LATEST 
    HERE aINTERPS 10 + !d 
        ]
            aINTERPS @d
        [ 
    -61 ,b aINTERPS 10 + @d 
    aINTERPS @d 4 + !d

CREATE IMMEDIATE 
    HERE aINTERPS 10 + !d 
        ]
            LATEST 8 + @b 1 | LATEST 8 + !b
        [ 
    -61 ,b aINTERPS 10 + @d 
    LATEST 4 + !d

// COMPILE is an immediate word that forces a word to be compiled even if it is immediate
CREATE COMPILE 
    HERE aINTERPS 10 + !d 
        ]
            WORD FIND ECR32
        [ 
    -61 ,b aINTERPS 10 + @d 
    LATEST 4 + !d IMMEDIATE

CREATE :
    HERE aCOMP_START !d
        ]
            // colon makes a dictionary entry, sets COMP_START, and enters compile mode
            // it also initially sets the new word's flag byte to HIDDEN so that definitions
            // can reference older definitions of the same word
            CREATE HERE aCOMP_START !d 2 LATEST 8 + !b ]
        [
    -61 ,b COMP_START
    LATEST 4 + !d

// semicolon finishes a definition by compiling a `ret` and patching the code pointer as well as flag byte of the new word
// semicolon needs to be immediate since otherwise it wouldn't exit compilation
: ; COMPILE [ -61 ,b COMP_START LATEST 4 + !d 0 LATEST 8 + !b [ -61 ,b COMP_START LATEST 4 + !d 0 LATEST 8 + !b IMMEDIATE

// Useful for debugging without accidentally corrupting the stack.
: PEEK DUP . ;

// 0BRANCH is to 0BR what LITERAL is to LIT.
: 0BRANCH [ WORD 0BR FIND ] LITERAL ECR32 ,d ; IMMEDIATE
// unconditional branch
: BRANCH 0 COMPILE LITERAL COMPILE 0BRANCH ; IMMEDIATE

// Since this Forth is untyped, the only thing we \
// really care about is the *size* of a variable,
// these words define the common data widths.
: BYTE_T 1 ;
: WORD_T 2 ;
: DWORD_T 4 ;
: QWORD_T 8 ;

// VARIABLE is relatively complicated, but essentially we \
// create a new word, and make that word push the address of a \
// block of memory it owns, who's size is the argument to VARIABLE.
// So it could be used like CELL VARIABLE X to make a variable called X with \
// a size of 8 bytes.
// Note that VARIABLE shouldn't be called inside colon definitions, this is because \
// it is a defining word and would corrupt COMP_START as well as LATEST for the word that called it.
: VARIABLE CREATE HERE LATEST 4 + !d HERE 14 + COMPILE LITERAL -61 ,b ALLOT ; 

// CSTCK is the control flow stack, and CSPTR points to the next free slot in it.
WORD_T VARIABLE CSPTR
64 DWORD_T * VARIABLE CSTCK
// initialize the stack pointer to index 0 in the control flow stack
CSTCK CSPTR !w

// >C puts one value into the control flow stack
: >C CSPTR @w !d CSPTR @w DWORD_T + CSPTR !w ;

// C> pops one value from the control flow stack
: C> CSPTR @w DWORD_T SWAP - CSPTR !w CSPTR @w @d ;

// read the value at the top of the control flow stack without popping it
: C@ CSPTR @w DWORD_T SWAP - @d ;

// conditionals
: IF 0 COMPILE 0BRANCH HERE >C ; IMMEDIATE
: THEN C@ HERE - C> -4 + !d  ; IMMEDIATE
: ELSE 0 COMPILE BRANCH HERE COMPILE THEN >C ; IMMEDIATE

// loops
: BEGIN HERE >C ; IMMEDIATE
: UNTIL C> HERE 9 + SWAP - COMPILE 0BRANCH ; IMMEDIATE
: AGAIN C> HERE 22 + SWAP - COMPILE BRANCH ; IMMEDIATE
: REPEAT C> C> SWAP >C >C COMPILE AGAIN COMPILE ELSE C> POP ; IMMEDIATE
// WHILE is semantically just IF so we don't compile a separate code body for it,
// but it's useful to have a separate dictionary entry so that code is more readable.
// After all, BEGIN IF REPEAT is a bit weird and makes it unclear whether there should be a THEN.
CREATE WHILE IMMEDIATE WORD IF FIND 4 + @d LATEST 4 + !d

// INT64_MIN doubles as a mask for the sign bit
: INT64_MIN -9223372036854775808 ;
: INT64_MAX 9223372036854775807 ;

// comparison operators
: 0== IF 0 ELSE -1 THEN ;
: 0<> IF -1 ELSE 0 THEN ;
: -? INT64_MIN & IF -1 ELSE 0 THEN ;
: +? INT64_MIN & IF 0 ELSE -1 THEN ;
: == - IF 0 ELSE -1 THEN ;
: <> - IF -1 ELSE 0 THEN ;
: < 
    OVER -? OVER -? == // check if signs are equal
    IF
        - -? // same sign means we can subtract safely and check if result is smaller than 0
    ELSE
        SWAP POP -? // we don't need b anymore so we remove it, and return sign of a
    THEN
;
: <= OVER OVER == IF POP POP -1 ELSE < THEN ;
: > 
    OVER -? OVER -? == // check if signs are equal
    IF
        - -1 + +? // same sign means we can subtract safely and check if result is greater than 0
    ELSE
        SWAP POP +? // we don't need b anymore so we remove it, and return the opposite of the sign of a
    THEN
;
: >= OVER OVER == IF POP POP -1 ELSE > THEN ;

// "emit jump rel32", this is used for tail calls,
// note that since the compiler doesn't know when definitions end \
// you have to write EJR32 manually if you want something to be compiled as a tail call.
: EJR32 -23 ,b 4 + @d HERE 4 + SWAP - ,d ;

// Since semicolon patches a word's code address this means that writing \
// `: A A ;` will actually not recurse, but rather call whatever A's previous definition was
// so we provide SELF for recursion instead.
: SELF aCOMP_START -4 + ECR32 ; IMMEDIATE
// tail call version of SELF
: TSELF aCOMP_START -4 + EJR32 ; IMMEDIATE

// Take string pointer to filepath, attempt to open a file with it and redirect stdin to the file,
// closing whatever fd stdin was previously.
: EXEC
    // duplicate return value so we can call both dup2 and close with the fd
    >C 0 DUP DUP DUP DUP BASE C> + 2 SYSCALL // sys_open
    DUP +? IF
        DUP >C >C
        0 DUP DUP DUP 0 C> 33 SYSCALL // sys_dup2
        DUP +? IF 
            0 DUP DUP DUP DUP C> 3 SYSCALL POP // sys_close
            // we don't check the return value of sys_close because \
            // stdin has already been redirected and the script we're loading \
            // wouldn't necessarily be aware that it's being run through dup2 \
            // rather than the terminal, and as such this would force us to introduce \
            // either variable stack effects (very bad no good) or make every script \
            // pop one value when it initializes "just in case".
            // So leaving a duplicate fd open is really the lesser evil.
        THEN // dup2 failure
    THEN // open failure
;
// Version of EXEC that gets its input in a more REPL-friendly way.
: LOAD WORD EXEC ;